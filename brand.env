# Product identity: the one place to rename the product. Plain KEY=value lines.
# Read at build time by crates/ui-egui/build.rs (exported as FILMCRAFT_BRAND_* for the UI),
# apps/filmcraft/build.rs (Windows version info) and packaging/windows/package.ps1 (MSI name,
# manufacturer, folders, shortcuts, output file name).
# Changing BRAND_NAME or BRAND_ID also moves the per-user settings folder.
BRAND_NAME=Fusemovie
BRAND_COMPANY=Fuse
BRAND_ID=com.fuse.fusemovie
BRAND_FILE=fusemovie
